<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ModpackInstaller.ViewModels.ModpackBody"
             xmlns:asyncImage="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ModpackInstaller.Views.ModpackBody.ContentView"
             x:DataType="vm:ContentViewModel">
    <Design.DataContext>
        <vm:ContentViewModel />
    </Design.DataContext>
    
    <Border
        Background="#1A1D24"
        CornerRadius="12"
        Padding="20">

        <StackPanel Spacing="18">

            <!-- Top Bar -->
            <Grid ColumnDefinitions="*,Auto,Auto">

                <TextBox
                    Classes="centered"
                    Watermark="Search mods..."
                    CornerRadius="16"
                    Height="42"
                    Background="#2A2D35"
                    BorderBrush="#2A2D35"
                    Foreground="White"
                    Text="{Binding SearchQuery}"/>

                <Button
                    Grid.Column="1"
                    CornerRadius="16"
                    Margin="12,0,0,0"
                    Background="#3B82F6"
                    Foreground="White"
                    Padding="18,10"
                    Content="Browse Content"
                    Command="{Binding BrowseContentCommand}"
                    Cursor="Hand"/>

                <Button
                    Grid.Column="2"
                    CornerRadius="16"
                    Margin="8,0,0,0"
                    Background="#252A34"
                    Foreground="White"
                    Padding="18,10"
                    Content="Upload Files"
                    IsEnabled="False"
                    Cursor="Hand"/>
                    
                    

            </Grid>

            <!-- Filters -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10">

                <RadioButton
                    Classes="TabBarButton"
                    GroupName="Filter"
                    IsChecked="True"
                    Height="36">
                    All
                </RadioButton>

                <RadioButton
                    Classes="TabBarButton"
                    GroupName="Filter"
                    Height="36">
                    Mods
                </RadioButton>

            </StackPanel>

            <!-- Body -->
            <Border CornerRadius="16 16 0 0"
                    Background="#27292E">
                <StackPanel>
                    <!-- Header -->
                    
                    <Border CornerRadius="16 16 0 0"
                            BorderThickness="1"
                            BorderBrush="#34363c">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Height="44">

                            <TextBlock
                                Grid.Column="1"
                                Margin="16 0 0 0"
                                VerticalAlignment="Center"
                                Text="Project"
                                Foreground="#C7D2FE"
                                FontWeight="Bold"/>

                            <TextBlock
                                Grid.Column="2"
                                Margin="0 0 16 0 "
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="Actions"
                                Foreground="#C7D2FE"
                                FontWeight="Bold"/>


                        </Grid>
                    </Border>
                            
                    <!-- Items -->
                    <ListBox ItemsSource="{Binding Mods}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate> 
                                <Border BorderThickness="1 0 1 1"
                                        BorderBrush="#34363c"
                                        Background="#1d1f23"
                                        Padding="12">

                                    <Grid ColumnDefinitions="60,*,180">

                                        <!-- Icon -->
                                        <Border
                                            Width="48"
                                            Height="48"
                                            CornerRadius="8"
                                            Background="#27292E"
                                            BorderBrush="#34363c"
                                            BorderThickness="1"/>
                                        
                                        <asyncImage:AdvancedImage
                                            Grid.Column="0"
                                            Source="{Binding IconUrl}"
                                            Width="42"
                                            Height="42"/>

                                        <!-- Info -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="10,0">

                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="White"/>
                                            
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4">
                                                
                                            <TextBlock Text="{Binding OwnerName}"
                                                       Foreground="#9CA3AF" />
                                            
                                            <TextBlock Text="•"
                                                       Foreground="#9CA3AF" />
                                            
                                            <TextBlock Text="{Binding VersionNumber}"
                                                       Foreground="#9CA3AF" />
                                            
                                            </StackPanel>


                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12">

                                            <Button
                                                Width="36"
                                                Height="36"
                                                Background="Transparent">
                                                <Svg Path="/Assets/arrow-left-right.svg"
                                                     Width="16"
                                                     Height="16"
                                                     Css="* { color: #FFFFFF}"/>
                                            </Button>

                                            <ToggleSwitch
                                                Command="{Binding $parent[ListBox].((vm:ContentViewModel)DataContext)?.ToggleModCommand}"
                                                CommandParameter="{Binding}"
                                                IsChecked="{Binding Enabled, Mode=OneWay}"/>

                                            <Button
                                                Width="36"
                                                Height="36"
                                                Background="Transparent"
                                                Command="{Binding $parent[ListBox].((vm:ContentViewModel)DataContext)?.RemoveModCommand}"
                                                CommandParameter="{Binding}">
                                                <Svg Path="/Assets/trash.svg"
                                                     Width="16"
                                                     Height="16"
                                                     Css="* { color: #FFFFFF; }"/> 
                                            </Button>

                                        </StackPanel>

                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </StackPanel>
                
            </Border>

        </StackPanel>

    </Border>
</UserControl>
