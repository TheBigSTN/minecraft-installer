<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ModpackInstaller.ViewModels.ModpackBody"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="ModpackInstaller.Views.ModpackBody.FilesView"
             x:DataType="vm:FilesViewModel"
             Background="#18181b">

    <Design.DataContext>
        <vm:FilesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto" Margin="16">
            <!-- Home / Navigation Root Button -->
            <Button Grid.Column="0" 
                    Command="{Binding GoHomeCommand}"
                    Background="#27272a" 
                    Foreground="White" 
                    Width="36" 
                    Height="36"
                    CornerRadius="8" 
                    HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    Margin="0,0,12,0">
                <PathIcon Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Width="16" Height="16" />
            </Button>

            <!-- Current Folder Title / Breadcrumb -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsRoot}">
                <TextBlock Text="/" Foreground="#71717a" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentFolderName}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search Bar -->
            <Grid Grid.Column="2" Width="260" HorizontalAlignment="Right" Margin="0,0,12,0">
                <TextBox Watermark="Search files"
                         Background="#27272a" BorderBrush="#3f3f46" Foreground="White"
                         CornerRadius="8" Padding="32,6,12,6" />
                <PathIcon
                    Data="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5z"
                    Width="14" Height="14" Foreground="#a1a1aa"
                    Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsHitTestVisible="False" />
            </Grid>

            <!-- Refresh Button -->
            <Button Grid.Column="3" 
                    Command="{Binding RefreshCommand}"
                    Background="#27272a" Foreground="White" Padding="12,8"
                    CornerRadius="8" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon
                        Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                        Width="14" Height="14" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Actions Add (+) Button -->
            <Button Grid.Column="4" 
                    Background="#27272a" 
                    Foreground="White" 
                    Padding="12,8"
                    CornerRadius="8" 
                    VerticalAlignment="Center"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="14" Height="14" />
                    <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10" Foreground="#a1a1aa" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Files DataGrid -->
        <Border Grid.Row="1" Background="#202024" BorderBrush="#27272a" BorderThickness="1"
                CornerRadius="12" Margin="16,0,16,16" Padding="4">
            <StackPanel Spacing="8">
                <!-- Table Header -->
                <Grid ColumnDefinitions="48, *, 140, 180, 180, 80"
                      Height="36"
                      Margin="0,0,0,4">
                    <CheckBox Grid.Column="0" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center" 
                              IsEnabled="False"/>
                    <TextBlock Grid.Column="1" Text="Name" 
                               Foreground="#a1a1aa" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Size" 
                               Foreground="#a1a1aa" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Created" 
                               Foreground="#a1a1aa" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Modified" 
                               Foreground="#a1a1aa" VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Actions" 
                               Foreground="#a1a1aa" HorizontalAlignment="Center"
                               VerticalAlignment="Center" 
                               FontWeight="SemiBold" />
                </Grid>

                <!-- Files List -->
                <ListBox ItemsSource="{Binding Files}"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         Padding="0"
                         SelectionMode="Multiple">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:FileItem">
                            <Grid ColumnDefinitions="48, *, 140, 180, 180, 80"
                                  Height="40"
                                  Background="Transparent">

                                <!-- 1. Checkbox Column (Independent) -->
                                <CheckBox Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" 
                                          IsEnabled="False"/>

                                <!-- 2. Row Navigation Button (Spans Name, Size, Created, Modified) -->
                                <Button Grid.Column="1" Grid.ColumnSpan="4"
                                        Command="{Binding $parent[UserControl].((vm:FilesViewModel)DataContext).NavigateCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Padding="0">
                                    <Grid ColumnDefinitions="*, 140, 180, 180">
                                        <!-- Name Sub-column -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center">
                                            <PathIcon
                                                Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                                Width="16" Height="16" Foreground="#3b82f6" />
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Size Sub-column -->
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" />

                                        <!-- Created Sub-column -->
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedText}" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" />

                                        <!-- Modified Sub-column -->
                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- 3. Actions Column (Independent) -->
                                <Button Grid.Column="5"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="#a1a1aa"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <PathIcon
                                        Data="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                        Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>