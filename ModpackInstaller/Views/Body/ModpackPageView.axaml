<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ModpackInstaller.ViewModels.Body"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ModpackInstaller.Views.Body.ModpackPageView"
             x:DataType="vm:ModpackPageViewModel">
    <UserControl.Styles>
        <Style Selector="DropDownButton.Kebab">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="100">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        
        <Border
            Background="#1A1D24"
            Padding="20">

            <StackPanel Spacing="20">

                <!-- HEADER -->

                <Grid ColumnDefinitions="90,*,Auto,Auto,Auto">

                    <!-- Icon -->
                    <Border Width="72"
                            Height="72"
                            CornerRadius="10"
                            Background="#252A34">

                        <!-- <Image Source="{Binding Icon}" Stretch="Uniform"/> -->
                        <Svg Width="30"
                             Height="30"
                             Path="/Assets/square.svg"/>
                    </Border>

                    <!-- Text -->
                    <StackPanel Grid.Column="1"
                                Margin="18,0">

                        <TextBlock
                            Text="{Binding Name, FallbackValue='Default Name'}"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="White"/>

                        <StackPanel Orientation="Horizontal"
                                    
                                    Spacing="10">

                            <Border
                                VerticalAlignment="Center"
                                CornerRadius="6"
                                Padding="8,3">

                                <TextBlock
                                    Text="{Binding Loader, FallbackValue='NeoForge'}"
                                    Foreground="White"/>
                            </Border>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding GameVersion, FallbackValue='1.21.1'}"
                                Foreground="#BFBFBF"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- Play -->
                    <Button
                        Grid.Column="2"
                        Background="#3B82F6"
                        Foreground="White"
                        Padding="26,12"
                        Content="Outdated Version Install Latest"
                        IsVisible="{Binding IsLatestVersion, Converter={StaticResource NegateBool}}"
                        Command="{Binding UpdateModpackCommand}"/>
                    
                    <Button Grid.Column="3"
                            Background="#333333"
                            Classes="SideButton"
                            Command="{Binding SettingsPopUpCommand}">
                        <Svg Width="30"
                             Height="30"
                             Css="* { color : #CCCCCC}"
                             Path="/Assets/settings.svg"/>
                    </Button>

                    <DropDownButton Grid.Column="4"
                                    Background="#333333"
                                    Classes="SideButton Kebab"
                                    Width="40"
                                    Height="40"
                                    Cursor="Hand">
                        <DropDownButton.Content>
                            <Svg Width="30"
                                 Height="30"
                                 Css="* { color: #CCCCCC }"
                                 Path="/Assets/ellipsis-vertical.svg"/>
                        </DropDownButton.Content>

                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Open Folder"
                                          Command="{Binding OpenDirectoryCommand}" />
                                <!-- <MenuItem Header="Delete" -->
                                <!--           Command="{Binding SettingsPopUpCommand}" /> -->
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <Border
                    Background="#222831"
                    CornerRadius="26"
                    Height="52"
                    HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton GroupName="PackNav"
                                     Classes="SideButton"
                                     Width="114"
                                     Height="36"
                                     Margin="8  0 2 0 "
                                     IsChecked="True"
                                     Command="{Binding ContentPageCommand}">
                            Content
                        </RadioButton>
                        
                        <RadioButton GroupName="PackNav"
                                     Classes="SideButton"
                                     Width="114"
                                     Height="36"
                                     Margin="2"
                                     Command="{Binding FilesPageCommand}"
                                     IsEnabled="True">
                            Files
                        </RadioButton>
                        <RadioButton GroupName="PackNav"
                                     Classes="SideButton"
                                     Width="114"
                                     Height="36"
                                     Margin="2 0 8 0"
                                     Command="{Binding ConfigPageCommand}"
                                     IsEnabled="False">
                            Config
                        </RadioButton>

                    </StackPanel>

                </Border>
                
                <Border>
                    <ContentControl
                        VerticalAlignment="Stretch"
                        Content="{Binding BodyViewModel}"/>
                        <!-- ZIndex="1" -->
                </Border>
                
            </StackPanel>

        </Border>
        
    </ScrollViewer>

</UserControl>