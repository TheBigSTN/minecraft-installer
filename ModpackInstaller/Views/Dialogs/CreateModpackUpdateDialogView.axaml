<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ModpackInstaller.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ModpackInstaller.Views.Dialogs.CreateModpackUpdateDialogView"
             x:DataType="vm:CreateModpackUpdateDialogViewModel">
    
    <Dialog MinWidth="800"> <!-- Added MinWidth to prevent horizontal resizing -->
        <DialogHeader>
            <DialogTitle>
                Create New Version
            </DialogTitle>
            
            <DialogCloseButton Command="{Binding CloseCommand}" />
        </DialogHeader>
        
        <DialogContent>
            <Pages>
            
                <!-- Pagină 1: Update -->
                <Page PageTag="update"
                      Margin="20"
                      Validator="{Binding ValidateUpdatePage}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Setări Update"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding ValidationError}"
                                   FontSize="16"
                                   Foreground="#AA0000"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Nume versiune"/>
                        <TextBox Watermark="ex. Release 1"
                                 Text="{Binding VersionName}"/>

                        <TextBlock Text="SemVer"/>
                        <TextBox Watermark="ex. 1.0.0"
                                 Text="{Binding Semver}"/>

                        <PageNavigation/>
                    </StackPanel>
                </Page>
            
                <!-- Pagină 2: Included Files -->
                <Page PageTag="files">
                    <TreeView ItemsSource="{Binding Root.Children}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Margin="2">
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Margin="26,0,0,0" FontSize="11" Opacity="0.6" 
                                               Text="{Binding Description}" IsVisible="{Binding Description}"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    
                    <StackPanel Orientation="Horizontal"
                                Spacing="5">
                        <PageBackButton />
                        <Button Content="Create" 
                                Command="{Binding CreateCommand}" 
                                Classes="SecondaryButton"/>
                    </StackPanel>
                </Page>
            
            </Pages>
            
        </DialogContent>
        
        <!-- <DialogFooter> -->
        <!--     <StackPanel Orientation="Horizontal" Spacing="8"> -->
        <!--         ~1~ <Button Content="Create" Command="{Binding CreateCommand}" /> @1@ -->
        <!--         ~1~ <Button Content="Cancel" Command="{Binding CloseCommand}" /> @1@ -->
        <!--     </StackPanel> -->
        <!-- </DialogFooter> -->
    </Dialog>
    
</UserControl>