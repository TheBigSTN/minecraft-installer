<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModpackInstaller.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ModpackInstaller.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
		x:DataType="vm:MainViewModel"
        x:Class="ModpackInstaller.Views.MainWindow"
        Icon="/Assets/image-1.ico"
        Title="Modpack Installer"
        MinHeight="512"
        MinWidth="1024"
        Background="#FF1E1E1E"
        TransparencyLevelHint="None"
        CanResize="True"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaChromeHints="NoChrome"
		ExtendClientAreaTitleBarHeightHint="56">

	<!-- Folosim un Border cu colțuri rotunjite și shadow pentru efect modern -->
	<Border CornerRadius="40"
            Background="#FF1E1E1E"
            Padding="0"
            Margin="0">
		<Grid>
			<Border>
				<Border.Effect>
					<BlurEffect Radius="{Binding DialogBlurRadius}" />
				</Border.Effect>
				<Grid ColumnDefinitions="64,*"
			      RowDefinitions="52,*"
			      Background="#121212">

				<!--
				<ContentControl
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					ZIndex="1"
					Content="{Binding TopBarViewModel}"/>
					
						<ContentControl
					Grid.Row="1"
					Grid.Column="0"
					VerticalAlignment="Stretch"
					HorizontalAlignment="Stretch"
					Content="{Binding SidebarViewModel}"/>
					SideNavigationBarView
				-->
				<views:NavigationBarView
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					ZIndex="1"/>

				<ContentControl
					Grid.Row="1"
					Grid.Column="0"
					VerticalAlignment="Stretch"
					ZIndex="1"
					Content="{Binding SideNavigationViewModel}"/>

				<ContentControl
					Grid.Row="1"
					Grid.Column="1"
					VerticalAlignment="Stretch"
					HorizontalAlignment="Stretch"
					Content="{Binding BodyViewModel}"/>
			</Grid>
			</Border>
			<!-- Blur overlay -->
			<Border
				IsVisible="{Binding IsDialogOpen}"
				Background="#80000000">
				<Border.Effect>
					<BlurEffect Radius="{Binding DialogBlurRadius}" />
				</Border.Effect>
			</Border>

			<!-- Dialog -->
			<ContentControl
				IsVisible="{Binding IsDialogOpen}"
				Content="{Binding CurrentDialog}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"/>
		</Grid>
	</Border>
</Window>